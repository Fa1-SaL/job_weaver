# Required for JD generation
OPENAI_API_KEY=

# Local React development and preview defaults are already allowed. Override
# with a comma-separated exact-origin list for deployed frontends.
JOB_WEAVER_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
JOB_WEAVER_ALLOWED_HOSTS=localhost,127.0.0.1

# Local loopback use works without a token. Set this for any non-local deploy.
# Use the same secret value for this variable on Render and Vercel. On Vercel,
# keep it server-only: never rename it with a VITE_ prefix.
JOB_WEAVER_API_TOKEN=
JOB_WEAVER_USER_ID=default

# Vercel server-only setting used by frontend/api/proxy.ts. Leave this unset on
# Render. The URL must be HTTPS and must not include a path.
RENDER_BACKEND_URL=https://job-weaver.onrender.com

# For multiple scoped users, use a JSON object instead of the single token:
# JOB_WEAVER_API_TOKENS={"user-a":"replace-me","user-b":"replace-me"}

JOB_WEAVER_MAX_RAW_JD_CHARS=100000
JOB_WEAVER_MAX_REQUEST_BYTES=262144
JOB_WEAVER_GENERATION_RATE_LIMIT_PER_MINUTE=12
JOB_WEAVER_HISTORY_LIMIT=100
JOB_WEAVER_CACHE_VERSION=3
